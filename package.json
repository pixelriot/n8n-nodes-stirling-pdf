{
    "name": "n8n-nodes-stirling-pdf",
    "version": "0.1.0",
    "description": "n8n community node for the Stirling PDF processing API",
    "license": "MIT",
    "homepage": "https://github.com/lraeskin/n8n-nodes-stirling-pdf",
    "keywords": [
        "n8n-community-node-package",
        "n8n",
        "stirling-pdf",
        "pdf"
    ],
    "author": {
        "name": "Luc Raeskin",
        "email": "lraeskin@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/lraeskin/n8n-nodes-stirling-pdf.git"
    },
   "scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
    "files": [
        "dist"
    ],
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/StirlingPdfApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/StirlingPdf/StirlingPdf.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
